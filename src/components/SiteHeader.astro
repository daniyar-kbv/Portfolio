---
import { headerNavItems, siteAssets, siteOwner } from '../data/site';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems?: NavItem[];
}

const { navItems = headerNavItems } = Astro.props as Props;
---

<header class="wix-header-shell">
  <div class="wix-header-inner">
    <a href="/" class="wix-logo-link" aria-label={`${siteOwner.displayName} home`}>
      <img
        src={siteAssets.logo}
        alt={siteOwner.displayName}
        width="324"
        height="128"
        class="wix-logo-image"
        loading="eager"
        decoding="async"
      />
    </a>

    <button
      type="button"
      class="wix-nav-toggle"
      aria-label="Open navigation menu"
      aria-controls="site-primary-navigation"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="wix-nav-toggle-line"></span>
      <span class="wix-nav-toggle-line"></span>
    </button>

    <nav id="site-primary-navigation" aria-label="Primary" class="wix-nav" data-nav-menu>
      {navItems.map((item) => (
        <a
          href={item.href}
          class="wix-nav-link"
        >
          {item.label}
        </a>
      ))}
    </nav>

  </div>
</header>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const navMenu = document.querySelector<HTMLElement>('[data-nav-menu]');
  const desktopQuery = window.matchMedia('(min-width: 901px)');

  const setNavOpen = (isOpen: boolean) => {
    if (!navToggle || !navMenu) return;

    navToggle.setAttribute('aria-expanded', String(isOpen));
    navToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    navMenu.classList.toggle('is-open', isOpen);
    document.documentElement.classList.toggle('wix-nav-open', isOpen);
  };

  navToggle?.addEventListener('click', () => {
    setNavOpen(navToggle.getAttribute('aria-expanded') !== 'true');
  });

  navMenu?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      setNavOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navToggle?.getAttribute('aria-expanded') === 'true') {
      setNavOpen(false);
      navToggle.focus();
    }
  });

  desktopQuery.addEventListener('change', (event) => {
    if (event.matches) {
      setNavOpen(false);
    }
  });
</script>
