---
import ContactActions from './ContactActions.astro';
import ProfilePortrait from './ProfilePortrait.astro';
import { siteAssets } from '../data/assets';
import { siteContact, siteOwner } from '../data/identity';

interface Props {
  email?: string;
  linkedinUrl?: string;
  compact?: boolean;
}

const {
  email = siteContact.email,
  linkedinUrl = siteContact.linkedin.url,
  compact = false,
} = Astro.props as Props;
const links = [
  {
    title: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: siteAssets.icons.contact,
  },
  {
    title: 'LinkedIn',
    value: siteContact.linkedin.label,
    href: linkedinUrl,
    icon: siteAssets.icons.linkedin,
  },
];
---

<section id="contact" class:list={['site-strip contact-section', compact && 'contact-section--compact']}>
  <div class="section-divider"></div>
  <div class="site-footer-inner contact-home-inner">
    <div class="contact-main">
      <div class="contact-card">
        <div class="contact-profile">
          <ProfilePortrait class="contact-portrait" />
          <div class="contact-identity">
            <p class="contact-kicker">Contact</p>
            <h2 class="contact-heading">Need this kind of app work?</h2>
            <p class="contact-name">{siteOwner.publicName}</p>
            <p class="contact-location">{siteOwner.legalName} · {siteOwner.location}</p>
          </div>
        </div>
        {!compact && (
          <p class="contact-note">Tell me what you’re shipping, stabilizing, or modernizing.</p>
        )}
        <ContactActions
          actions={links}
          variant="home"
          showChevron={!compact}
          iconLoading="eager"
        />
      </div>
    </div>
  </div>
</section>
