---
import IconImage from './IconImage.astro';
import { siteAssets, siteContact, siteOwner } from '../data/site';

interface Props {
  email?: string;
  linkedinUrl?: string;
  compact?: boolean;
}

const {
  email = siteContact.email,
  linkedinUrl = siteContact.linkedin.url,
  compact = false,
} = Astro.props as Props;
const links = [
  {
    title: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: siteAssets.icons.contact,
  },
  {
    title: 'LinkedIn',
    value: siteContact.linkedin.label,
    href: linkedinUrl,
    icon: siteAssets.icons.linkedin,
  },
];
---

<section id="contact" class:list={['wix-strip wix-contact-section', compact && 'wix-contact-section--compact']}>
  <div class="wix-section-divider"></div>
  <div class="wix-footer-inner wix-contact-home-inner">
    <div class="wix-contact-main">
      <div class="wix-contact-card">
        <div class="wix-contact-profile">
          <img
            src={siteAssets.profilePortrait}
            alt={siteAssets.profilePortraitAlt}
            class="wix-contact-portrait"
            loading="lazy"
            decoding="async"
          />
          <div class="wix-contact-identity">
            <p class="wix-contact-kicker">Contact</p>
            <h2 class="wix-contact-heading">Need this kind of app work?</h2>
            <p class="wix-contact-name">{siteOwner.publicName}</p>
            <p class="wix-contact-location">{siteOwner.legalName} · {siteOwner.location}</p>
          </div>
        </div>
        {!compact && (
          <p class="wix-contact-note">Tell me what you’re shipping, stabilizing, or modernizing.</p>
        )}
        <div class="wix-contact-hero-links">
          {links.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer noopener' : undefined}
              aria-label={`${link.title}: ${link.value}`}
              class="wix-contact-hero-link group"
            >
              <span class="wix-contact-hero-icon">
                <IconImage
                  src={link.icon}
                  class="absolute inset-0 h-full w-full object-contain transition-transform group-hover:scale-105"
                  loading="eager"
                />
              </span>
              <span class="wix-contact-hero-copy">
                <span class="wix-contact-hero-title">{link.title}</span>
                <span class="wix-contact-hero-label">{link.value}</span>
              </span>
              {!compact && <span class="wix-contact-hero-chevron" aria-hidden="true">›</span>}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
