---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ProjectSummary from '../../components/ProjectSummary.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import CaseStudySection from '../../components/CaseStudySection.astro';
import ProjectContactCTA from '../../components/ProjectContactCTA.astro';
import RelatedProjects from '../../components/RelatedProjects.astro';
import { siteAssets } from '../../data/assets';
import { homepageHero } from '../../data/homepage';
import {
  selectRelatedProjects,
  selectProjectMediaBanners,
  shouldRenderProjectLinks,
  shouldRenderProjectMedia,
  sortProjectsByPriority,
} from '../../lib/projects';
import { absoluteUrl, buildProjectStructuredData, formatProjectSeoTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = sortProjectsByPriority(await getCollection('projects'));
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const mediaBanners = selectProjectMediaBanners(project);
const hasMediaSection = shouldRenderProjectMedia(project);
const hasLinksSection = shouldRenderProjectLinks(project);
const seoImage = data.thumbnail || siteAssets.seoImage;
const heroMedia = mediaBanners[0] ?? siteAssets.heroImage;
const heroMediaAlt = mediaBanners[0] ? `${data.title} product visual` : homepageHero.bannerAlt;
const projectSeoTitle = formatProjectSeoTitle(project);
const canonicalUrl = absoluteUrl(`/projects/${project.slug}`, Astro.site);
const siteUrl = absoluteUrl('/', Astro.site);
const projectStructuredData = buildProjectStructuredData({
  project,
  pageUrl: canonicalUrl,
  imageUrl: absoluteUrl(seoImage, Astro.site),
  siteUrl,
});
const relatedProjects = selectRelatedProjects(project, projects);
---

<BaseLayout
  title={projectSeoTitle}
  description={data.description}
  canonicalPath={`/projects/${project.slug}`}
  ogImage={seoImage}
  ogImageAlt={`${data.title} thumbnail`}
  ogTitle={projectSeoTitle}
  ogDescription={data.description}
  ogType="article"
  ogImageType={siteAssets.seoImageType}
  structuredData={projectStructuredData}
>
  <main id="content">
    <ProjectHero
      title={data.title}
      subtitle={data.subtitle}
      description={data.description}
      category={data.category}
      typeTags={data.typeTags}
      techTags={data.techTags}
      banner={heroMedia}
      bannerAlt={heroMediaAlt}
    />

    <nav class="project-back-affordance" aria-label="Project navigation">
      <a href="/#projects" class="project-back-link">Back to projects</a>
    </nav>

    <ProjectSummary
      role={data.role}
      status={data.status}
      stack={data.stack}
      highlights={data.highlights}
    />

    {hasMediaSection && <ProjectMedia title={data.title} banners={mediaBanners} />}

    <CaseStudySection>
      <Content />
    </CaseStudySection>

    <RelatedProjects currentTitle={data.title} projects={relatedProjects} />

    {hasLinksSection && <ProjectLinks links={data.links} />}

    <ProjectContactCTA />
  </main>
</BaseLayout>
