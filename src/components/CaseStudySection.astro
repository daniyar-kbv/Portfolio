---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<section class:list={['wix-section-shell wix-case-study-section', className]}>
  <div class="wix-section-inner">
    <div class="wix-case-study">
      <h2 class="wix-case-study-heading">Case study</h2>
      <div class="wix-case-study-content">
        <slot />
      </div>
    </div>
  </div>
</section>

<script>
  function splitCaseStudyCards() {
    document.querySelectorAll('.wix-case-study-content').forEach((content) => {
      if (content.querySelector('.wix-case-study-card')) return;

      const nodes = Array.from(content.childNodes);
      const fragment = document.createDocumentFragment();
      let currentCard = null;

      nodes.forEach((node) => {
        if (node.nodeType === Node.ELEMENT_NODE && node instanceof HTMLElement && node.tagName === 'H2') {
          currentCard = document.createElement('article');
          currentCard.className = 'wix-case-study-card';
          fragment.appendChild(currentCard);
        }

        if (!currentCard) {
          if (node.textContent?.trim()) {
            currentCard = document.createElement('article');
            currentCard.className = 'wix-case-study-card';
            fragment.appendChild(currentCard);
          } else {
            return;
          }
        }

        currentCard.appendChild(node);
      });

      content.appendChild(fragment);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', splitCaseStudyCards, { once: true });
  } else {
    splitCaseStudyCards();
  }
</script>
