---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  count?: string;
  class?: string;
}

const { id, eyebrow, title, description, count, class: className = '' } =
  Astro.props as Props;
---

<section id={id} class:list={['mx-auto w-full max-w-7xl px-6 py-10 sm:px-8 lg:px-10', className]}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-3xl">
      {eyebrow && <p class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)]">{eyebrow}</p>}
      <h2 class="mt-2 text-2xl font-semibold text-white sm:text-3xl">{title}</h2>
      {description && <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--color-text-muted)] sm:text-base">{description}</p>}
    </div>
    {count && <p class="text-xs uppercase tracking-[0.2em] text-[var(--color-text-soft)]">{count}</p>}
  </div>
  <slot />
</section>
