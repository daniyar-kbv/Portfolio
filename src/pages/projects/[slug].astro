---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import CaseStudySection from '../../components/CaseStudySection.astro';
import ContactSection from '../../components/ContactSection.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { contactLinks } from '../../data/contact';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const bodyDescription = project.data.subtitle || project.data.description;

function isRenderableMediaRef(value: string | null | undefined) {
  const trimmed = String(value ?? '').trim();
  if (!trimmed || trimmed.startsWith('wix:')) return false;
  if (trimmed.startsWith('/assets/')) return true;
  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return true;
  if (trimmed.startsWith('./') || trimmed.startsWith('../')) return true;
  return /^[^:/?#][^?#]*$/.test(trimmed);
}

function resolveOgImage(data: typeof project.data) {
  const candidates = [
    data.image,
    data.thumbnail,
    ...(data.screenshots ?? []),
  ];

  return candidates.find((value) => isRenderableMediaRef(value) && !/\.(mp4|mov|webm|m4v)$/i.test(String(value ?? '').trim()));
}

const ogImage = resolveOgImage(project.data);
---

<BaseLayout
  title={`${project.data.title} | Daniyar Kurmanbayev`}
  description={project.data.description}
  canonicalPath={`/projects/${project.slug}`}
  ogImage={ogImage}
  ogImageAlt={project.data.coverAlt || project.data.title}
  ogType="article"
>
  <main id="content">
    <ProjectHero
      title={project.data.title}
      subtitle={bodyDescription}
      description={project.data.description}
      category={project.data.category}
      typeTags={project.data.typeTags}
      techTags={project.data.techTags}
      links={project.data.links}
      role={project.data.role}
      status={project.data.status}
    />

    <ProjectMedia
      title={project.data.title}
      alt={project.data.coverAlt || `${project.data.title} banner`}
      image={project.data.image || project.data.thumbnail}
      media={project.data.media}
      screenshots={project.data.screenshots}
    />

    <CaseStudySection>
      <Content />
    </CaseStudySection>

    <ContactSection email="daniyar.kbv@gmail.com" linkedinUrl="https://www.linkedin.com/in/daniyar-kbv/" />
  </main>
  <SiteFooter contactLinks={contactLinks} />
</BaseLayout>
