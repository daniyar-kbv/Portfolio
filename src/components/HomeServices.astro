---
import SectionShell from './SectionShell.astro';

type ServiceIcon =
  | 'iphone.gen3'
  | 'wand.and.sparkles'
  | 'creditcard'
  | 'checkmark.seal'
  | 'wrench.and.screwdriver'
  | 'server.rack';

interface ServiceArea {
  title: string;
  description: string;
  icon: ServiceIcon;
  featured?: boolean;
}

interface Props {
  services: ServiceArea[];
}

const { services } = Astro.props as Props;

const serviceSymbols: Record<ServiceIcon, string> = {
  'iphone.gen3': '/assets/sf-symbols/iphone.gen3.svg',
  'wand.and.sparkles': '/assets/sf-symbols/wand.and.sparkles.svg',
  creditcard: '/assets/sf-symbols/creditcard.svg',
  'checkmark.seal': '/assets/sf-symbols/checkmark.seal.svg',
  'wrench.and.screwdriver': '/assets/sf-symbols/wrench.and.screwdriver.svg',
  'server.rack': '/assets/sf-symbols/server.rack.svg',
};
---

<SectionShell
  id="services"
  title="How I can help"
  description="Focused support for founders and teams who need senior iOS execution without losing product judgment."
  class="home-services-section"
>
  <div class="home-service-grid">
    {services.map((service) => {
      const symbol = serviceSymbols[service.icon];

      return (
        <article class:list={['home-service-card', service.featured && 'home-service-card--featured']}>
          <span class="home-service-glyph" aria-hidden="true">
            <span
              class="home-service-glyph-symbol"
              style={`--service-symbol-url: url('${symbol}')`}
            />
          </span>
          <div class="home-service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </article>
      );
    })}
  </div>
</SectionShell>
