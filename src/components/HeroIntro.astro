---
import ButtonLink from './ButtonLink.astro';
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  stats: Array<{ label: string; value: string }>;
  image: string;
  featured: Array<{
    title: string;
    subtitle: string;
    image?: string | null;
    href: string;
  }>;
}

const { title, description, stats, image, featured } = Astro.props as Props;
---

<section class="mx-auto w-full max-w-7xl px-6 py-8 sm:px-8 lg:px-10">
  <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
    <div class="rounded-sm border border-[var(--color-border)] px-0 py-2 sm:py-4">
      <div class="pb-6 pr-0 sm:pb-8 lg:pr-10">
        <p class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)]">
          Portfolio
        </p>
        <h1 class="mt-3 max-w-3xl text-3xl font-semibold leading-tight text-white sm:text-4xl">
          {title}
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
          {description}
        </p>

        <TagList
          tags={['iOS', 'Backend', 'Product Engineering', 'Astro', 'TypeScript']}
          class="mt-6"
        />

        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href="#flagship" variant="primary">Flagship work</ButtonLink>
          <ButtonLink href="#contact" variant="secondary">Contact</ButtonLink>
        </div>
      </div>

      <dl class="mt-8 grid gap-3 sm:grid-cols-3">
        {stats.map((stat) => (
          <div class="surface-strong rounded-sm p-4">
            <dt class="text-xs uppercase tracking-[0.2em] text-[var(--color-text-soft)]">
              {stat.label}
            </dt>
            <dd class="mt-2 text-2xl font-semibold text-white">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="rounded-sm border border-[var(--color-border)] p-4 sm:p-5">
      <div class="overflow-hidden rounded-sm border border-[var(--color-border)]">
        <img
          src={image}
          alt="Portfolio banner"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="aspect-[16/10] w-full object-cover"
        />
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {featured.map((project) => (
          <a
            href={project.href}
            class="surface-strong block rounded-sm p-4 transition hover:border-[var(--color-border-strong)] hover:bg-[var(--color-elevated-2)]"
          >
            <p class="text-xs uppercase tracking-[0.22em] text-[var(--color-text-soft)]">
              Featured
            </p>
            <p class="mt-2 text-sm font-semibold text-white">{project.title}</p>
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
              {project.subtitle}
            </p>
            {project.image && (
              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
                decoding="async"
                class="mt-4 aspect-[16/10] w-full rounded-sm object-cover"
              />
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
