---
import { ChevronLeft, ChevronRight, Maximize2, RotateCcw, X, ZoomIn, ZoomOut } from '@lucide/astro';
import { getRenderableMediaType, isRenderableMediaRef } from '../lib/media';

interface Props {
  title: string;
  banner?: string | null;
  banners?: string[];
}

const { title, banner = null, banners = [] } = Astro.props as Props;
const bannerCandidates = banners.length > 0 ? banners : [banner];
const renderBanners = bannerCandidates.filter((candidate): candidate is string => isRenderableMediaRef(candidate));
const hasMultipleBanners = renderBanners.length > 1;

function getBannerLabel(src: string, index: number) {
  const lowerSrc = src.toLowerCase();

  if (lowerSrc.includes('demo')) return 'demo video';
  if (lowerSrc.includes('mobile')) return 'mobile banner';
  if (lowerSrc.includes('web')) return 'web banner';
  if (lowerSrc.includes('telegram') || lowerSrc.includes('bot')) return 'Telegram bot banner';

  return `banner ${index + 1}`;
}

const firstBanner = renderBanners[0];
const firstBannerType = firstBanner ? getRenderableMediaType(firstBanner) : 'image';
const initialLightboxImage = renderBanners.find((renderBanner) => getRenderableMediaType(renderBanner) === 'image') ?? '';
const initialLightboxVideo = firstBannerType === 'video' ? firstBanner : '';
---

{renderBanners.length > 0 && (
  <section class="section-shell project-media-section">
    <div class="section-inner" data-project-lightbox>
      <div class="project-section-heading">
        <p class="project-section-kicker">Visuals</p>
        <h2>Product walkthrough</h2>
        <p>Tap or click the preview to open it fullscreen.</p>
      </div>
      <div
        class:list={['project-banner-carousel', { 'project-banner-carousel--single': !hasMultipleBanners }]}
        data-banner-carousel
        data-banner-autoplay={hasMultipleBanners ? 'true' : 'false'}
      >
        <div class="project-banner-viewport" data-banner-viewport>
          <div class="project-banner-track" data-banner-track>
            {renderBanners.map((renderBanner, index) => {
              const bannerLabel = hasMultipleBanners ? getBannerLabel(renderBanner, index) : 'banner';
              const alt = `${title} ${bannerLabel}`;
              const mediaType = getRenderableMediaType(renderBanner);

              return (
                <button
                  type="button"
                  class="project-banner-button"
                  aria-label={`Open ${alt} fullscreen`}
                  aria-hidden={index === 0 ? undefined : 'true'}
                  tabindex={index === 0 ? undefined : '-1'}
                  data-lightbox-open
                  data-banner-slide
                  data-banner-index={index}
                  data-banner-type={mediaType}
                >
                  {mediaType === 'video' ? (
                    <video
                      src={renderBanner}
                      muted
                      loop
                      playsinline
                      preload={index === 0 ? 'metadata' : 'none'}
                      class="project-gallery-image project-gallery-video"
                      data-banner-media
                    />
                  ) : (
                    <img
                      src={renderBanner}
                      alt={alt}
                      loading={index === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="project-gallery-image"
                      data-banner-media
                    />
                  )}
                  <span class="project-banner-expand-icon" aria-hidden="true">
                    <Maximize2 class="h-5 w-5" />
                  </span>
                </button>
              );
            })}
          </div>
        </div>

        {hasMultipleBanners && (
          <>
            <button
              type="button"
              class="project-banner-nav project-banner-nav--prev"
              aria-label={`Show previous ${title} banner`}
              data-banner-prev
            >
              <ChevronLeft class="h-5 w-5" aria-hidden="true" />
            </button>
            <button
              type="button"
              class="project-banner-nav project-banner-nav--next"
              aria-label={`Show next ${title} banner`}
              data-banner-next
            >
              <ChevronRight class="h-5 w-5" aria-hidden="true" />
            </button>
            <div class="project-banner-dots" aria-label={`${title} banner slides`}>
              {renderBanners.map((renderBanner, index) => {
                const bannerLabel = getBannerLabel(renderBanner, index);

                return (
                  <button
                    type="button"
                    class="project-banner-dot"
                    aria-label={`Show ${title} ${bannerLabel}`}
                    aria-current={index === 0 ? 'true' : 'false'}
                    data-banner-dot
                    data-banner-index={index}
                  />
                );
              })}
            </div>
          </>
        )}
      </div>

      <dialog class="project-lightbox" aria-label={`${title} banner fullscreen`} data-lightbox-dialog>
        <div class="project-lightbox-toolbar" aria-label="Banner viewer controls">
          <button
            type="button"
            class="project-lightbox-control"
            aria-label="Zoom out"
            data-lightbox-image-control
            data-lightbox-zoom-out
          >
            <ZoomOut class="h-5 w-5" aria-hidden="true" />
          </button>
          <button
            type="button"
            class="project-lightbox-control"
            aria-label="Zoom in"
            data-lightbox-image-control
            data-lightbox-zoom-in
          >
            <ZoomIn class="h-5 w-5" aria-hidden="true" />
          </button>
          <button
            type="button"
            class="project-lightbox-control"
            aria-label="Reset zoom"
            data-lightbox-image-control
            data-lightbox-reset
          >
            <RotateCcw class="h-5 w-5" aria-hidden="true" />
          </button>
          <button type="button" class="project-lightbox-control" aria-label="Close fullscreen banner" data-lightbox-close>
            <X class="h-5 w-5" aria-hidden="true" />
          </button>
        </div>
        <div class="project-lightbox-stage" data-lightbox-stage>
          <img
            src={initialLightboxImage}
            alt={`${title} ${hasMultipleBanners ? getBannerLabel(renderBanners[0], 0) : 'banner'}`}
            decoding="async"
            class="project-lightbox-image"
            draggable="false"
            data-lightbox-image
            hidden={firstBannerType === 'video'}
          />
          <video
            src={initialLightboxVideo}
            class="project-lightbox-video"
            controls
            playsinline
            preload="metadata"
            data-lightbox-video
            hidden={firstBannerType !== 'video'}
          />
        </div>
      </dialog>
    </div>
  </section>
)}

<script src="../scripts/project-lightbox.ts"></script>
