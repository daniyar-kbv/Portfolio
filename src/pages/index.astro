---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Daniyar Kurmanbayev"
  description="Fast static portfolio foundation for Daniyar Kurmanbayev."
>
  <main class="mx-auto flex min-h-screen w-full max-w-5xl items-center px-6 py-16 sm:px-10">
    <section class="w-full rounded-none border border-border bg-elevated/80 p-8 shadow-2xl shadow-black/20 backdrop-blur-sm sm:p-10">
      <p class="text-sm uppercase tracking-[0.24em] text-muted">Portfolio foundation</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-text sm:text-5xl">
        Daniyar Kurmanbayev
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">
        Fast static portfolio scaffolded with Astro, TypeScript, Tailwind CSS, MDX,
        and content collections for a clean migration from Wix content.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <span class="border border-border px-3 py-2 text-sm text-muted">Astro</span>
        <span class="border border-border px-3 py-2 text-sm text-muted">TypeScript</span>
        <span class="border border-border px-3 py-2 text-sm text-muted">Tailwind</span>
        <span class="border border-border px-3 py-2 text-sm text-muted">MDX</span>
      </div>

      <div class="mt-10 flex items-center justify-between gap-6 border-t border-border pt-6">
        <p class="max-w-xl text-sm leading-6 text-muted">
          Ready for project pages, writing, and structured content imports.
        </p>
        <div class="h-3 w-3 shrink-0 bg-accent" aria-hidden="true"></div>
      </div>
    </section>
  </main>
</BaseLayout>
