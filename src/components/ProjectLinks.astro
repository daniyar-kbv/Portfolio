---
import IconImage from './IconImage.astro';

interface LinkItem {
  type: string;
  label: string;
  url: string;
}

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props as Props;

const iconByType: Record<string, { icon: string }> = {
  github: {
    icon: '/assets/icons/github-icon.png',
  },
  'app store': {
    icon: '/assets/icons/app-store-icon.png',
  },
  website: {
    icon: '/assets/icons/website-icon.png',
  },
  instagram: {
    icon: '/assets/icons/instagram-icon.png',
  },
  demo: {
    icon: '/assets/icons/demo-icon.png',
  },
  linkedin: {
    icon: '/assets/icons/linkedin-icon.png',
  },
  email: {
    icon: '/assets/icons/contact-icon.png',
  },
};

function resolveIcon(type: string) {
  return iconByType[type.trim().toLowerCase()] || iconByType.website;
}

function getLabel(type: string, label: string) {
  return label?.trim() || type;
}
---

{links.length > 0 && (
  <section class="section-shell project-links-section">
    <div class="section-inner">
      <div class="project-links-wrap">
        <div class="project-section-heading project-section-heading--compact">
          <p class="project-section-kicker">Resources</p>
          <h2>Project links</h2>
        </div>
        <div class="project-links-grid project-links-grid--project">
          {links.map((link) => {
            const icon = resolveIcon(link.type);
            const label = getLabel(link.type, link.label);
            const isExternal = link.url.startsWith('http');
            return (
              <a
                href={link.url}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noreferrer noopener' : undefined}
                aria-label={`Open ${label}`}
                title={label}
                class="project-link-tile group"
              >
                <span class="relative h-20 w-20 shrink-0" aria-hidden="true">
                  <IconImage
                    src={icon.icon}
                    class="absolute inset-0 h-20 w-20 object-contain transition-transform group-hover:scale-105"
                    loading="lazy"
                  />
                </span>
                <span class="project-link-tile-label">{label}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}
