---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { siteAssets } from '../data/assets';
import { siteMeta, siteOwner } from '../data/identity';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  structuredData?: Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title = siteMeta.defaultTitle,
  description = siteMeta.defaultDescription,
  canonicalPath,
  ogImage = siteAssets.seoImage,
  ogImageAlt = title,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogImageWidth,
  ogImageHeight,
  ogImageType = siteAssets.seoImageType,
  structuredData = [],
  noindex = false,
} = Astro.props as Props;

const canonicalHref =
  canonicalPath && Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;
const ogImageHref = ogImage && Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;
const structuredDataJson =
  structuredData.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': structuredData }).replace(/</g, '\\u003c')
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteOwner.legalName} />
    <title>{title}</title>
    <link rel="icon" href={siteAssets.favicon} type="image/png" sizes="32x32" />
    <link rel="icon" href={siteAssets.favicon96} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={siteAssets.appleTouchIcon} sizes="180x180" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteMeta.siteName} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    {ogImageHref && <meta property="og:image" content={ogImageHref} />}
    {ogImageHref && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageHref && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHref && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogImageHref && <meta property="og:image:type" content={ogImageType} />}
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:card" content={ogImageHref ? 'summary_large_image' : 'summary'} />
    {ogImageHref && <meta name="twitter:image" content={ogImageHref} />}
    {ogImageHref && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="theme-color" content={siteMeta.themeColor} />
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:border focus:border-[var(--color-border-strong)] focus:bg-[var(--color-elevated)] focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <SiteHeader />
    <slot />
    <script src="../scripts/parallax-hero.ts"></script>
  </body>
</html>
