---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = '' } = Astro.props as Props;
---

<ul class:list={['flex flex-wrap gap-1.5', className]}>
  {tags.map((tag) => (
    <li
      class="max-w-full rounded-[10px] border border-[var(--color-border)] bg-[var(--color-elevated)] px-2.5 py-1 text-[12px] font-medium tracking-wide text-[var(--color-text-muted)]"
    >
      <span class="block max-w-full truncate whitespace-nowrap">{tag}</span>
    </li>
  ))}
</ul>
