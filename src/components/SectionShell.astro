---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  count?: string;
  icon?: string;
  iconAlt?: string;
  class?: string;
}

const { id, eyebrow, title, description, count, icon, iconAlt = '', class: className = '' } =
  Astro.props as Props;
---

<section id={id} class:list={['wix-section-shell py-8 sm:py-10', className]}>
  <div class="wix-section-inner">
    <div class="wix-divider-thick"></div>
    <div class="wix-divider-thin"></div>
    <div class="wix-section-frame mt-4 px-4 py-4 sm:px-6 sm:py-6">
      <div class="wix-section-header wix-section-header--center">
        {count && <p class="wix-section-kicker wix-section-count">{count}</p>}
        <div class="wix-section-heading">
          {icon && <img src={icon} alt={iconAlt} class="wix-section-icon" loading="lazy" decoding="async" />}
          <div>
            {eyebrow && <p class="wix-section-kicker">{eyebrow}</p>}
            <h2 class="mt-2 wix-section-title">{title}</h2>
            {description && <p class="mt-3 wix-section-description">{description}</p>}
          </div>
        </div>
      </div>
      <div class="mt-6">
        <slot />
      </div>
    </div>
  </div>
</section>
