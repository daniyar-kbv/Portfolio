---
interface Props {
  name: string;
  role: string;
  label: string;
  bannerImage: string;
  bannerAlt?: string;
}

const { name, role, label, bannerImage, bannerAlt = 'Portfolio banner' } = Astro.props as Props;

const parentheticalNameMatch = name.match(/^(.+?)\s+\((.+)\)$/);
const primaryName = parentheticalNameMatch?.[2] ?? name;
const secondaryName = parentheticalNameMatch?.[1] ?? null;
---

<section class="wix-home-hero" data-parallax-hero data-parallax-travel="72">
  <div class="wix-parallax-frame">
    <img
      src={bannerImage}
      alt={bannerAlt}
      width="1512"
      height="222"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="wix-home-banner wix-parallax-image"
      data-parallax-image
    />
    <div class="wix-home-banner-overlay">
      <div class="wix-home-banner-copy">
        <p class="wix-home-banner-label">{label}</p>
        <h1 class="wix-home-banner-name">{primaryName}</h1>
        {secondaryName && <p class="wix-home-banner-secondary-name">{secondaryName}</p>}
        <p class="wix-home-banner-role">{role}</p>
      </div>
    </div>
  </div>
</section>
