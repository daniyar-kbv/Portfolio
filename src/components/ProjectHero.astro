---
import ButtonLink from './ButtonLink.astro';
import TagList from './TagList.astro';
import ProjectLinks from './ProjectLinks.astro';

interface LinkItem {
  type: string;
  label: string;
  url: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  category: string;
  typeTags: string[];
  techTags: string[];
  links: LinkItem[];
  role?: string;
  year?: number;
  status?: string;
}

const {
  title,
  subtitle,
  description,
  category,
  typeTags,
  techTags,
  links,
  role,
  year,
  status,
} = Astro.props as Props;
---

<section class="mx-auto w-full max-w-7xl px-6 py-8 sm:px-8 lg:px-10">
  <div class="surface rounded-sm p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <ButtonLink href="/" variant="secondary">Back to projects</ButtonLink>
      <p class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)]">{category}</p>
    </div>

    <h1 class="mt-5 max-w-4xl text-3xl font-semibold leading-tight text-white sm:text-4xl">
      {title}
    </h1>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
      {subtitle}
    </p>
    <p class="mt-4 max-w-4xl text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
      {description}
    </p>

    <div class="mt-5 flex flex-wrap gap-3 text-xs text-[var(--color-text-soft)]">
      {role && <span>{role}</span>}
      {year && <span>{year}</span>}
      {status && <span>{status}</span>}
    </div>

    <TagList tags={typeTags} class="mt-6" />
    <TagList tags={techTags} class="mt-3" />

    <div class="mt-7">
      <ProjectLinks links={links} />
    </div>
  </div>
</section>
