---
import ProjectCard from './ProjectCard.astro';
import SectionShell from './SectionShell.astro';
import type { ProjectCategory } from '../data/site';
import type { ProjectEntry } from '../lib/projects';
import { selectProjectCardImage } from '../lib/projects';

interface Props {
  id: string;
  category: ProjectCategory;
  title: string;
  description?: string;
  projects: ProjectEntry[];
}

const { id, category, title, description, projects } = Astro.props as Props;

const sectionIcons: Record<ProjectCategory, string> = {
  Recent: '/assets/icons/production-icon.png',
  Flagship: '/assets/icons/flagship-icon.png',
  Production: '/assets/icons/production-icon.png',
  Backend: '/assets/icons/backend-icon.png',
  AI: '/assets/icons/ai-icon.png',
  Legacy: '/assets/icons/legacy-icon.png',
};
---

<SectionShell
  id={id}
  title={title}
  description={description}
  icon={sectionIcons[category]}
  iconAlt={`${category} icon`}
>
  <div class="wix-repeater-grid wix-repeater-grid--two">
    {projects.map((project) => {
      const image = selectProjectCardImage(project);

      return (
        <ProjectCard
          slug={project.slug}
          title={project.data.title}
          subtitle={project.data.subtitle}
          description={project.data.description}
          techTags={project.data.techTags}
          image={image}
          alt={project.data.coverAlt || `${project.data.title} preview`}
          showVisual={category !== 'AI'}
        />
      );
    })}
  </div>
</SectionShell>
