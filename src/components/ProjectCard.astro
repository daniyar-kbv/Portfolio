---
import TagList from './TagList.astro';

interface LinkItem {
  type: string;
  label: string;
  url: string;
}

interface Props {
  slug: string;
  title: string;
  subtitle: string;
  description: string;
  typeTags: string[];
  techTags: string[];
  image?: string | null;
  alt?: string;
  links?: LinkItem[];
  status?: string;
}

const {
  slug,
  title,
  subtitle,
  description,
  typeTags,
  techTags,
  image,
  alt = `${title} preview`,
  links = [],
  status,
} = Astro.props as Props;

const internalHref = `/projects/${slug}`;

const linkIcons: Record<string, { icon: string; hoverIcon: string }> = {
  github: {
    icon: '/assets/icons/github-icon.png',
    hoverIcon: '/assets/icons/github-icon-hover.png',
  },
  'app store': {
    icon: '/assets/icons/app-store-icon.png',
    hoverIcon: '/assets/icons/app-store-icon-hover.png',
  },
  website: {
    icon: '/assets/icons/website-icon.png',
    hoverIcon: '/assets/icons/website-icon-hover.png',
  },
  instagram: {
    icon: '/assets/icons/instagram-icon.png',
    hoverIcon: '/assets/icons/instagram-icon-hover.png',
  },
  demo: {
    icon: '/assets/icons/demo-icon.png',
    hoverIcon: '/assets/icons/demo-icon-hover.png',
  },
  linkedin: {
    icon: '/assets/icons/linkedin-icon.png',
    hoverIcon: '/assets/icons/linkedin-icon-hover.png',
  },
};
---

<article class="wix-project-card group transition duration-150 hover:border-[var(--color-border-strong)]">
  <a href={internalHref} class="block wix-project-media" aria-label={`Open ${title} project`}>
    {image ? (
      <img
        src={image}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full object-cover transition duration-150 group-hover:scale-[1.01]"
      />
    ) : (
      <div class="flex aspect-[16/10] items-end justify-between p-4">
        <div class="flex flex-col gap-2">
          <span class="wix-section-kicker">{status || 'Project'}</span>
          <span class="max-w-[12rem] text-[18px] font-semibold leading-6 text-white">{title}</span>
        </div>
      </div>
    )}
  </a>

  <div class="wix-project-body">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="wix-section-kicker break-words">{subtitle}</p>
        <h3 class="mt-2 text-[18px] font-semibold leading-6 text-white">
          <a href={internalHref} class="transition hover:text-[var(--color-accent-hover)]">
            {title}
          </a>
        </h3>
      </div>
      {status && <span class="wix-section-kicker shrink-0 text-right">{status}</span>}
    </div>

    <p class="mt-3 break-words text-[14px] leading-6 text-[var(--color-text-muted)]">
      {description}
    </p>

    <TagList tags={typeTags} class="mt-4" />
    <TagList tags={techTags} class="mt-3" />

    <div class="mt-4 flex flex-wrap gap-2">
      <a href={internalHref} class="wix-project-link-chip" aria-label={`Open project page for ${title}`}>
        <span class="wix-project-link-text text-[var(--color-accent)]">View project</span>
      </a>
      {links.slice(0, 3).map((link) => {
        const key = link.type.toLowerCase();
        const icon = linkIcons[key];
        const isExternal = link.url.startsWith('http');

        return (
          <a
            href={link.url}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noreferrer noopener' : undefined}
            aria-label={`${link.type}: ${link.label}`}
            title={link.label}
            class="wix-project-link-chip group"
          >
            {icon && (
              <span class="relative h-4 w-4 shrink-0">
                <img
                  src={icon.icon}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 h-4 w-4 object-contain transition-opacity group-hover:opacity-0"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  src={icon.hoverIcon}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 h-4 w-4 object-contain opacity-0 transition-opacity group-hover:opacity-100"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            )}
            <span class="wix-project-link-text">{link.type}</span>
          </a>
        );
      })}
    </div>
  </div>
</article>
