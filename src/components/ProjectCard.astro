---
interface Props {
  slug: string;
  title: string;
  subtitle: string;
  description: string;
  techTags: string[];
  image?: string | null;
  alt?: string;
  status?: string;
}

const { slug, title, subtitle, description, techTags, image, alt = `${title} preview`, status } =
  Astro.props as Props;

const internalHref = `/projects/${slug}`;
const techLine = techTags.join(' · ');
---

<article class="wix-project-card">
  <a href={internalHref} class="wix-project-card-link" aria-label={`Open ${title} project`}>
    <div class="wix-project-card-media">
      {image ? (
        <img
          src={image}
          alt={alt}
          loading="lazy"
          decoding="async"
          class="wix-project-card-image"
        />
      ) : (
        <div class="wix-project-card-placeholder">
          <span class="wix-project-card-placeholder-kicker">{subtitle}</span>
          <span class="wix-project-card-placeholder-title">{title}</span>
        </div>
      )}
    </div>

    <div class="wix-project-card-copy">
      <p class="wix-project-card-kicker">{subtitle}</p>
      <h3 class="wix-project-card-title">{title}</h3>
      {status && <p class="wix-project-card-status" title={status}>{status}</p>}
      <p class="wix-project-card-description">{description}</p>
      {techLine && <p class="wix-project-card-tech">{techLine}</p>}
      <span class="wix-project-card-button">Learn More</span>
    </div>
  </a>
</article>
