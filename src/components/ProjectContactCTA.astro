---
import ContactActions from './ContactActions.astro';
import ProfilePortrait from './ProfilePortrait.astro';
import { siteAssets } from '../data/assets';
import { siteContact, siteOwner } from '../data/identity';

const contactActions = [
  {
    title: 'Email',
    value: siteContact.email,
    href: `mailto:${siteContact.email}`,
    icon: siteAssets.icons.contact,
  },
  {
    title: 'LinkedIn',
    value: siteContact.linkedin.label,
    href: siteContact.linkedin.url,
    icon: siteAssets.icons.linkedin,
  },
];
---

<section class="section-shell project-contact-section">
  <div class="section-inner">
    <article class="project-contact-card">
      <ProfilePortrait class="project-contact-portrait" />
      <div class="project-contact-copy">
        <p class="project-section-kicker">Contact</p>
        <h2>Need this kind of app work?</h2>
        <p>Tell me what you’re shipping, stabilizing, or modernizing.</p>
        <p class="project-contact-identity">{siteOwner.publicName} · {siteOwner.legalName}</p>
      </div>

      <ContactActions actions={contactActions} variant="project" ariaLabel="Contact options" />
    </article>
  </div>
</section>
