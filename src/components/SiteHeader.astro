---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems?: NavItem[];
}

const defaultNavItems: NavItem[] = [
  { label: 'Flagship', href: '/#flagship' },
  { label: 'Production', href: '/#production' },
  { label: 'Backend', href: '/#backend' },
  { label: 'AI', href: '/#ai' },
  { label: 'Legacy', href: '/#legacy' },
  { label: 'Contact', href: '/#contact' },
];

const { navItems = defaultNavItems } = Astro.props as Props;
const isHome = Astro.url.pathname === '/';
---

<header class="wix-header-shell">
  <div class="wix-header-inner">
    <a href="/" class="wix-logo-link" aria-label="Daniyar Kurmanbayev home">
      <img
        src="/assets/logo/logo-horizontal.png"
        alt="Daniyar Kurmanbayev"
        width="324"
        height="128"
        class="wix-logo-image"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav aria-label="Primary" class="wix-nav">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isHome && item.href === '/#flagship' ? 'page' : undefined}
          class="wix-nav-link"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href="/#contact" class="wix-header-cta">Contact</a>
  </div>
</header>
