---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIntro from '../components/HeroIntro.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { homepageHero, homepageMeta, homepageSections, siteAssets } from '../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.priority - b.data.priority,
);

const projectsByCategory = Object.fromEntries(
  homepageSections.map((section) => [
    section.category,
    projects.filter((project) => project.data.category === section.category),
  ]),
);
---

<BaseLayout
  title={homepageMeta.title}
  description={homepageMeta.description}
  canonicalPath="/"
  ogImage={siteAssets.seoImage}
  ogImageAlt={homepageMeta.ogImageAlt}
  ogTitle={homepageMeta.title}
  ogDescription={homepageMeta.description}
>
  <main id="content">
    <HeroIntro
      name={homepageHero.name}
      role={homepageHero.role}
      label={homepageHero.label}
      bannerImage={siteAssets.heroImage}
      bannerAlt={homepageHero.bannerAlt}
    />

    {homepageSections.map((section) => (
      <ProjectSection
        id={section.id}
        category={section.category}
        title={section.title}
        projects={projectsByCategory[section.category] ?? []}
      />
    ))}

    <ContactSection />
  </main>
</BaseLayout>
