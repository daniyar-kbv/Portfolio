---
import ContactActions from './ContactActions.astro';
import ProfilePortrait from './ProfilePortrait.astro';
import { siteAssets } from '../data/assets';
import { siteContact, siteOwner } from '../data/identity';

interface Props {
  email?: string;
  linkedinUrl?: string;
  compact?: boolean;
}

const {
  email = siteContact.email,
  linkedinUrl = siteContact.linkedin.url,
  compact = false,
} = Astro.props as Props;
const links = [
  {
    title: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: siteAssets.icons.contact,
  },
  {
    title: 'LinkedIn',
    value: siteContact.linkedin.label,
    href: linkedinUrl,
    icon: siteAssets.icons.linkedin,
  },
];
---

<section id="contact" class:list={['wix-strip wix-contact-section', compact && 'wix-contact-section--compact']}>
  <div class="wix-section-divider"></div>
  <div class="wix-footer-inner wix-contact-home-inner">
    <div class="wix-contact-main">
      <div class="wix-contact-card">
        <div class="wix-contact-profile">
          <ProfilePortrait class="wix-contact-portrait" />
          <div class="wix-contact-identity">
            <p class="wix-contact-kicker">Contact</p>
            <h2 class="wix-contact-heading">Need this kind of app work?</h2>
            <p class="wix-contact-name">{siteOwner.publicName}</p>
            <p class="wix-contact-location">{siteOwner.legalName} · {siteOwner.location}</p>
          </div>
        </div>
        {!compact && (
          <p class="wix-contact-note">Tell me what you’re shipping, stabilizing, or modernizing.</p>
        )}
        <ContactActions
          actions={links}
          variant="home"
          showChevron={!compact}
          iconLoading="eager"
        />
      </div>
    </div>
  </div>
</section>
