---
import SectionShell from './SectionShell.astro';
import type { ProjectEntry } from '../lib/projects';
import { selectProjectCardImage } from '../lib/projects';

interface Props {
  featuredProjects: ProjectEntry[];
  compactProjects: ProjectEntry[];
  outcomes: Record<string, string>;
  outcomeHeadlines?: Record<string, string>;
}

const { featuredProjects, compactProjects, outcomes, outcomeHeadlines = {} } = Astro.props as Props;

function getOutcome(project: ProjectEntry) {
  return outcomes[project.slug] ?? project.data.description;
}

function getOutcomeHeadline(project: ProjectEntry) {
  return outcomeHeadlines[project.slug] ?? project.data.title;
}
---

<SectionShell
  id="selected-work"
  title="Selected client outcomes"
  description="Recent work chosen for the kinds of client problems it proves: launch risk, AI API integration, payments, entitlement logic, mobile/backend delivery, and App Store readiness."
  class="home-selected-work-section"
>
  <div class="home-featured-proof-grid">
    {featuredProjects.map((project) => {
      const image = selectProjectCardImage(project);

      return (
        <article class="home-featured-proof-card">
          <a href={`/projects/${project.slug}`} class="home-featured-proof-link" aria-label={`Open ${project.data.title} project`}>
            {image && (
              <div class="home-featured-proof-media">
                <img
                  src={image}
                  alt={project.data.coverAlt || `${project.data.title} preview`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="home-featured-proof-copy">
              <p class="home-proof-project-label">{project.data.title}</p>
              <h3>{getOutcomeHeadline(project)}</h3>
              <p class="home-featured-proof-outcome">{getOutcome(project)}</p>
              <p class="home-proof-kicker">{project.data.subtitle}</p>
              {project.data.status && <p class="home-featured-proof-status">{project.data.status}</p>}
              <span class="home-text-cta">View case study <span aria-hidden="true">›</span></span>
            </div>
          </a>
        </article>
      );
    })}
  </div>

  <div class="home-compact-proof-grid" aria-label="Additional recent proof">
    {compactProjects.map((project) => {
      const image = selectProjectCardImage(project);

      return (
        <a href={`/projects/${project.slug}`} class="home-compact-proof-card">
          {image && (
            <div class="home-compact-proof-media">
              <img
                src={image}
                alt={project.data.coverAlt || `${project.data.title} preview`}
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="home-compact-proof-copy">
            <p class="home-proof-kicker">{project.data.subtitle}</p>
            <h3>{project.data.title}</h3>
            <p>{getOutcome(project)}</p>
            <span class="home-text-cta">View project <span aria-hidden="true">›</span></span>
          </div>
        </a>
      );
    })}
  </div>
</SectionShell>
