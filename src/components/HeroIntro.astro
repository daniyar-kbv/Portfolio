---
interface Props {
  name: string;
  role: string;
  label: string;
  bannerImage: string;
}

const { name, role, label, bannerImage } = Astro.props as Props;
---

<section class="wix-section-shell pt-8 sm:pt-10">
  <div class="wix-section-inner">
    <div class="wix-divider-thick"></div>
    <div class="wix-divider-thin"></div>
    <div class="wix-section-frame mt-4 overflow-hidden">
      <div class="relative">
        <img
          src={bannerImage}
          alt="Portfolio banner"
          width="980"
          height="366"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="wix-home-banner"
        />
        <div class="wix-home-banner-overlay">
          <div class="wix-home-banner-copy">
            <p class="wix-home-banner-name">{name}</p>
            <p class="wix-home-banner-role">{role}</p>
            <p class="wix-home-banner-label">{label}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
