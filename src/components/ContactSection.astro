---
interface Props {
  email: string;
  linkedinUrl: string;
}

const { email, linkedinUrl } = Astro.props as Props;
const links = [
  {
    title: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: '/assets/icons/contact-icon.png',
    hoverIcon: '/assets/icons/contact-icon-hover.png',
  },
  {
    title: 'LinkedIn',
    value: 'daniyar-kbv',
    href: linkedinUrl,
    icon: '/assets/icons/linkedin-icon.png',
    hoverIcon: '/assets/icons/linkedin-icon-hover.png',
  },
];
---

<section id="contact" class="wix-strip">
  <div class="wix-divider-accent"></div>
  <div class="wix-footer-inner py-6">
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="max-w-2xl">
        <p class="wix-text-9 uppercase tracking-[0.24em] text-[var(--color-text-soft)]">Contact</p>
        <h2 class="mt-2 text-[var(--wix-font-5)] font-semibold leading-[1.4] text-white">
          Available for iOS, backend, and product engineering work.
        </h2>
        <p class="mt-3 max-w-xl text-[var(--wix-font-8)] leading-6 text-[var(--color-text-muted)]">
          Direct contact is preferred for project work, technical audits, and freelance engagements.
        </p>
      </div>

      <div class="wix-contact-grid">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer noopener' : undefined}
            aria-label={`${link.title}: ${link.value}`}
            class="wix-contact-tile group"
          >
            <span class="relative h-6 w-6 shrink-0">
              <img
                src={link.icon}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-6 w-6 object-contain transition-opacity group-hover:opacity-0"
                loading="lazy"
                decoding="async"
              />
              <img
                src={link.hoverIcon}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-6 w-6 object-contain opacity-0 transition-opacity group-hover:opacity-100"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="wix-contact-copy">
              <span class="wix-contact-title">{link.title}</span>
              <span class="wix-contact-value">{link.value}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
