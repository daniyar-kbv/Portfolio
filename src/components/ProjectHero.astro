---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  banner?: string | null;
  bannerAlt?: string;
}

const { title, subtitle, description, banner, bannerAlt = `${title} banner` } = Astro.props as Props;
---

<section class="wix-section-shell pt-8 sm:pt-10">
  <div class="wix-section-inner">
    <div class="wix-divider-thick"></div>
    <div class="wix-divider-thin"></div>

    {banner && (
      <div class="wix-section-frame mt-4 overflow-hidden">
        <img
          src={banner}
          alt={bannerAlt}
          width="980"
          height="366"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="wix-project-banner"
        />
      </div>
    )}

    <div class="wix-project-header">
      <h1 class="wix-project-title">{title}</h1>
      <p class="wix-project-subtitle">{subtitle}</p>
      <p class="wix-project-description">{description}</p>
    </div>
  </div>
</section>
