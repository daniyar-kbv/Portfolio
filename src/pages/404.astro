---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { siteOwner } from '../data/identity';

---

<BaseLayout
  title={`Page not found | ${siteOwner.displayName}`}
  description="The requested page could not be found."
  canonicalPath="/404"
  noindex
>
  <main id="content" class="mx-auto w-full max-w-3xl px-6 py-20 sm:px-8 lg:px-10">
    <section class="surface rounded-sm p-6 sm:p-8">
      <p class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)]">404</p>
      <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Page not found</h1>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
        The page you were looking for does not exist or has moved.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href="/" variant="primary">Back to homepage</ButtonLink>
        <ButtonLink href="/#contact" variant="secondary">Contact</ButtonLink>
      </div>
    </section>
  </main>
</BaseLayout>
