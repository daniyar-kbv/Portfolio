---
import ArchiveProjectCard from './ArchiveProjectCard.astro';
import SectionShell from './SectionShell.astro';
import type { ProjectCategory } from '../data/project-taxonomy';
import type { ProjectEntry } from '../lib/projects';
import { selectProjectCardImage } from '../lib/projects';

interface ArchiveSection {
  id: string;
  category: ProjectCategory;
  title: string;
  description: string;
}

interface Props {
  sections: ArchiveSection[];
  projectsByCategory: Record<ProjectCategory, ProjectEntry[]>;
}

const { sections, projectsByCategory } = Astro.props as Props;

const sectionIcons: Record<ProjectCategory, string> = {
  Recent: '/assets/icons/recent-client-work-icon.png',
  Flagship: '/assets/icons/flagship-icon.png',
  Production: '/assets/icons/production-icon.png',
  Backend: '/assets/icons/backend-icon.png',
  AI: '/assets/icons/ai-icon.png',
  Legacy: '/assets/icons/legacy-icon.png',
};
---

<SectionShell
  id="projects"
  title="More selected work"
  description="A compact archive of older production builds, platform work, libraries, and experiments."
  class="wix-home-project-archive-section"
>
  <div class="wix-home-archive-stack">
    {sections.map((section) => {
      const projects = projectsByCategory[section.category] ?? [];

      if (projects.length === 0) return null;

      return (
        <section id={section.id} class="wix-home-archive-group" aria-labelledby={`${section.id}-heading`}>
          <div class="wix-home-archive-heading">
            <img
              src={sectionIcons[section.category]}
              alt=""
              class="wix-home-archive-icon"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3 id={`${section.id}-heading`}>{section.title}</h3>
              <p>{section.description}</p>
            </div>
          </div>
          <div class="wix-repeater-grid wix-repeater-grid--archive-compact">
            {projects.map((project) => {
              const image = selectProjectCardImage(project);

              return (
                <ArchiveProjectCard
                  slug={project.slug}
                  title={project.data.title}
                  subtitle={project.data.subtitle}
                  description={project.data.description}
                  techTags={project.data.techTags}
                  image={image}
                  alt={project.data.coverAlt || `${project.data.title} preview`}
                  showVisual={section.category !== 'AI'}
                />
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</SectionShell>
