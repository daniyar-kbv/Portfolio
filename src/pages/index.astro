---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIntro from '../components/HeroIntro.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contactLinks } from '../data/contact';
import localAssets from '../data/local-assets.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.priority - b.data.priority,
);

const sectionOrder = ['Flagship', 'Production', 'Backend', 'AI', 'Legacy'];

const projectsByCategory = Object.fromEntries(
  sectionOrder.map((category) => [
    category,
    projects.filter((project) => project.data.category === category),
  ]),
);

const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const totalProjects = projects.length;
const totalLinks = projects.reduce((count, project) => count + project.data.links.length, 0);
const heroImage = localAssets.shared.hero[0];
const seoImage = localAssets.shared.seo[0] ?? heroImage;
---

<BaseLayout
  title="Portfolio | Daniyar Kurmanbayev (Dan Kurman)"
  description="Daniyar Kurmanbayev (Dan Kurman), Senior iOS Developer & Technical Product Manager. I build Swift/SwiftUI apps with clean architecture, strong UX, and reliable delivery. View projects and case studies."
  canonicalPath="/"
  ogImage={seoImage}
  ogImageAlt="Portfolio SEO image"
  ogTitle="Portfolio | Daniyar Kurmanbayev (Dan Kurman)"
  ogDescription="Daniyar Kurmanbayev (Dan Kurman), Senior iOS Developer & Technical Product Manager. I build Swift/SwiftUI apps with clean architecture, strong UX, and reliable delivery. View projects and case studies."
>
  <main id="content">
    <HeroIntro
      title="Daniyar Kurmanbayev"
      description="iOS, backend, and product engineering portfolio with senior freelance credibility built from shipped work."
      image={heroImage}
      stats={[
        { label: 'Projects', value: String(totalProjects) },
        { label: 'Links', value: String(totalLinks) },
        { label: 'Featured', value: String(featuredProjects.length) },
      ]}
      featured={featuredProjects.map((project) => ({
        title: project.data.title,
        subtitle: project.data.subtitle,
        image: project.data.thumbnail || project.data.image || project.data.screenshots?.[0] || null,
        href: `/projects/${project.slug}`,
      }))}
    />

    {sectionOrder.map((category) => (
      <ProjectSection
        id={category.toLowerCase()}
        title={category}
        description={`Projects grouped under ${category.toLowerCase()} work, ordered by portfolio priority.`}
        projects={projectsByCategory[category] ?? []}
      />
    ))}

    <ContactSection email="daniyar.kbv@gmail.com" linkedinUrl="https://www.linkedin.com/in/daniyar-kbv/" />
  </main>
  <SiteFooter contactLinks={contactLinks} />
</BaseLayout>
