---
import ProjectCardContent from './ProjectCardContent.astro';
import ProjectCardMedia from './ProjectCardMedia.astro';

interface Props {
  slug: string;
  title: string;
  subtitle: string;
  description: string;
  techTags: string[];
  image?: string | null;
  alt?: string;
  status?: string;
  showVisual?: boolean;
}

const {
  slug,
  title,
  subtitle,
  description,
  techTags,
  image,
  alt = `${title} preview`,
  status,
  showVisual = true,
} = Astro.props as Props;

const internalHref = `/projects/${slug}`;
const techLine = techTags.join(' · ');
---

<article class="project-card">
  <a
    href={internalHref}
    class:list={['project-card-link', !showVisual && 'project-card-link--text-only']}
    aria-label={`Open ${title} project`}
  >
    {showVisual && <ProjectCardMedia title={title} subtitle={subtitle} image={image} alt={alt} />}
    <ProjectCardContent
      title={title}
      subtitle={subtitle}
      description={description}
      techLine={techLine}
      status={status}
    />
  </a>
</article>
