---
import ButtonLink from './ButtonLink.astro';

interface Props {
  email: string;
  linkedinUrl: string;
}

const { email, linkedinUrl } = Astro.props as Props;
---

<section id="contact" class="mx-auto w-full max-w-7xl px-6 py-10 sm:px-8 lg:px-10">
  <div class="border-t border-[var(--color-border)] pt-6">
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)]">Contact</p>
        <h2 class="mt-2 text-2xl font-semibold text-white sm:text-3xl">
          Available for iOS, backend, and product engineering work.
        </h2>
        <p class="mt-3 text-sm leading-6 text-[var(--color-text-muted)]">
          Direct contact is preferred for project work, technical audits, and freelance engagements.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <ButtonLink href={`mailto:${email}`} variant="primary">
          {email}
        </ButtonLink>
        <ButtonLink href={linkedinUrl} external variant="secondary">
          LinkedIn
        </ButtonLink>
      </div>
    </div>
  </div>
</section>
