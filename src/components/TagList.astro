---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = '' } = Astro.props as Props;
---

<ul class:list={['flex flex-wrap gap-2', className]}>
  {tags.map((tag) => (
    <li
      class="rounded-sm border border-[var(--color-border)] bg-[var(--color-elevated)] px-3 py-1 text-xs font-medium tracking-wide text-[var(--color-text-muted)]"
    >
      {tag}
    </li>
  ))}
</ul>
