---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionShell from '../components/SectionShell.astro';
import TagList from '../components/TagList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contactLinks } from '../data/contact';
import localAssets from '../data/local-assets.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.priority - b.data.priority,
);

const sectionOrder = ['Flagship', 'Production', 'Backend', 'AI', 'Legacy'];

const projectAssets = localAssets.projects;

const projectsByCategory = Object.fromEntries(
  sectionOrder.map((category) => [
    category,
    projects.filter((project) => project.data.category === category),
  ]),
);

const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const totalProjects = projects.length;
const totalLinks = projects.reduce((count, project) => count + project.data.links.length, 0);
const heroImage = localAssets.shared.hero[0];

function resolveAsset(project) {
  const asset = projectAssets[project.data.slug] ?? {};
  return {
    thumbnail: asset.thumbnail ?? null,
    image: asset.image ?? null,
    screenshots: asset.screenshots ?? [],
    media: asset.media ?? [],
    missing: asset.missing ?? [],
  };
}

function projectMedia(project) {
  const asset = resolveAsset(project);
  return asset.thumbnail || asset.image || asset.screenshots[0] || null;
}
---

<BaseLayout
  title="Daniyar Kurmanbayev"
  description="Daniyar Kurmanbayev portfolio. iOS, backend, and machine learning projects."
  canonicalPath="/"
  ogImage={heroImage}
  ogImageAlt="Portfolio hero banner"
>
  <main id="content">
    <section class="mx-auto w-full max-w-7xl px-6 py-8 sm:px-8 lg:px-10">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-stretch">
        <div class="rounded-sm border border-[var(--color-border)] px-0 py-2 sm:py-4">
          <div class="pb-6 pr-0 sm:pb-8 lg:pr-10">
            <p class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)]">
              Portfolio
            </p>
            <h1 class="mt-3 max-w-3xl text-3xl font-semibold leading-tight text-white sm:text-4xl">
              Daniyar Kurmanbayev
            </h1>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
              Selected iOS, backend, and ML work rebuilt from the Wix portfolio into a fast
              static Astro site.
            </p>

            <TagList
              tags={['Astro', 'TypeScript', 'Tailwind CSS', 'MDX', 'Content Collections']}
              class="mt-6"
            />

            <div class="mt-8 flex flex-wrap gap-3">
              <ButtonLink href="#flagship" variant="primary">Flagship work</ButtonLink>
              <ButtonLink href="#contact" variant="secondary">Contact</ButtonLink>
            </div>
          </div>

          <dl class="mt-8 grid gap-3 sm:grid-cols-3">
            <div class="surface-strong rounded-sm p-4">
              <dt class="text-xs uppercase tracking-[0.2em] text-[var(--color-text-soft)]">
                Projects
              </dt>
              <dd class="mt-2 text-2xl font-semibold text-white">{totalProjects}</dd>
            </div>
            <div class="surface-strong rounded-sm p-4">
              <dt class="text-xs uppercase tracking-[0.2em] text-[var(--color-text-soft)]">
                Links
              </dt>
              <dd class="mt-2 text-2xl font-semibold text-white">{totalLinks}</dd>
            </div>
            <div class="surface-strong rounded-sm p-4">
              <dt class="text-xs uppercase tracking-[0.2em] text-[var(--color-text-soft)]">
                Featured
              </dt>
              <dd class="mt-2 text-2xl font-semibold text-white">{featuredProjects.length}</dd>
            </div>
          </dl>
        </div>

        <div class="rounded-sm border border-[var(--color-border)] p-4 sm:p-5">
          <div class="overflow-hidden rounded-sm border border-[var(--color-border)]">
            <img
              src={heroImage}
              alt="Apps banner"
              class="aspect-[16/10] w-full object-cover"
            />
          </div>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {featuredProjects.map((project) => {
              const image = projectMedia(project);
              return (
                <div class="surface-strong rounded-sm p-4">
                  <p class="text-xs uppercase tracking-[0.22em] text-[var(--color-text-soft)]">
                    {project.data.category}
                  </p>
                  <p class="mt-2 text-sm font-semibold text-white">{project.data.title}</p>
                  <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
                    {project.data.subtitle}
                  </p>
                  {image && (
                    <img
                      src={image}
                      alt={project.data.coverAlt || project.data.title}
                      class="mt-4 aspect-[16/10] w-full rounded-sm object-cover"
                    />
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    {sectionOrder.map((category) => {
      const projectsInSection = projectsByCategory[category] ?? [];
      const sectionId = category.toLowerCase();

      return (
        <SectionShell
          id={sectionId}
          eyebrow={category}
          title={`${category} projects`}
          description={`A concise cross-section of the portfolio grouped by ${category.toLowerCase()} work.`}
          count={`${projectsInSection.length} projects`}
        >
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {projectsInSection.map((project, index) => {
              const asset = resolveAsset(project);
              return (
                <ProjectCard
                  title={project.data.title}
                  subtitle={project.data.subtitle}
                  description={project.data.description}
                  tags={[...project.data.typeTags, ...project.data.techTags].slice(0, 5)}
                  image={asset.thumbnail || asset.image || asset.screenshots[0] || null}
                  alt={project.data.coverAlt || project.data.title}
                  links={project.data.links}
                  status={project.data.status}
                  year={project.data.year}
                  index={index + 1}
                />
              );
            })}
          </div>
        </SectionShell>
      );
    })}

  </main>
  <SiteFooter contactLinks={contactLinks} />
</BaseLayout>
