---
interface ProofPoint {
  label: string;
  description: string;
}

interface Props {
  proofPoints: ProofPoint[];
}

const { proofPoints } = Astro.props as Props;
---

<section class="home-proof-strip" aria-label="Selected proof points">
  <div class="section-divider"></div>
  <div class="home-proof-inner">
    {proofPoints.map((proofPoint) => (
      <div class="home-proof-item">
        <p class="home-proof-label">{proofPoint.label}</p>
        <p class="home-proof-description">{proofPoint.description}</p>
      </div>
    ))}
  </div>
</section>
