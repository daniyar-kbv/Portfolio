---
import ButtonLink from './ButtonLink.astro';
import TagList from './TagList.astro';

interface LinkItem {
  type: string;
  label: string;
  url: string;
}

interface Props {
  slug: string;
  title: string;
  subtitle: string;
  description: string;
  typeTags: string[];
  techTags: string[];
  image?: string | null;
  alt?: string;
  links?: LinkItem[];
  status?: string;
  year?: number;
}

const {
  slug,
  title,
  subtitle,
  description,
  typeTags,
  techTags,
  image,
  alt = `${title} preview`,
  links = [],
  status,
  year,
} = Astro.props as Props;

const internalHref = `/projects/${slug}`;
---

<article class="group overflow-hidden rounded-sm border border-[var(--color-border)] bg-[var(--color-elevated)] transition duration-150 hover:border-[var(--color-border-strong)] hover:bg-[var(--color-elevated-2)]">
  <a href={internalHref} class="block border-b border-[var(--color-border)]" aria-label={`Open ${title} project`}>
    {image ? (
      <img
        src={image}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full object-cover"
      />
    ) : (
      <div class="flex aspect-[16/10] items-end justify-between p-4">
        <div class="flex flex-col gap-2">
          <span class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)]">
            {status || 'Project'}
          </span>
          <span class="max-w-[12rem] text-lg font-semibold leading-tight text-white">
            {title}
          </span>
        </div>
        {typeof year === 'number' && (
          <span class="text-sm text-[var(--color-text-soft)]">{year}</span>
        )}
      </div>
    )}
  </a>

  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.24em] text-[var(--color-text-soft)] break-words">{subtitle}</p>
        <h3 class="mt-2 text-xl font-semibold text-white">
          <a href={internalHref} class="transition hover:text-[var(--color-accent-hover)]">
            {title}
          </a>
        </h3>
      </div>
      {year && <span class="text-xs text-[var(--color-text-soft)]">{year}</span>}
    </div>

    <p class="mt-4 text-sm leading-6 text-[var(--color-text-muted)] break-words">{description}</p>

    <TagList tags={typeTags} class="mt-5" />
    <TagList tags={techTags} class="mt-3" />

    <div class="mt-5 flex flex-wrap gap-2">
      <ButtonLink href={internalHref} variant="primary">View project</ButtonLink>
      {links.slice(0, 2).map((link) => (
        <ButtonLink href={link.url} external={link.url.startsWith('http')} variant="ghost">
          {link.label}
        </ButtonLink>
      ))}
    </div>
  </div>
</article>
