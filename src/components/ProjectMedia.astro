---
interface Props {
  title: string;
  items?: string[];
}

function isRenderableMediaRef(value: string | null | undefined) {
  const trimmed = String(value ?? '').trim();
  if (!trimmed || trimmed.startsWith('wix:')) return false;
  if (trimmed.startsWith('/assets/')) return true;
  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return true;
  if (trimmed.startsWith('./') || trimmed.startsWith('../')) return true;
  return /^[^:/?#][^?#]*$/.test(trimmed);
}

const { title, items = [] } = Astro.props as Props;
const renderableItems = items.filter(isRenderableMediaRef);
---

{renderableItems.length > 0 && (
  <section class="wix-section-shell py-6 sm:py-8">
    <div class="wix-section-inner">
      <img
        src={renderableItems[0]}
        alt={`${title} banner`}
        loading="lazy"
        decoding="async"
        class="wix-project-banner"
      />
    </div>
  </section>
)}
