---
interface Props {
  title: string;
  description: string;
  banner?: string | null;
  bannerAlt?: string;
}

const { title, description, banner, bannerAlt = `${title} banner` } = Astro.props as Props;
---

<section class="wix-project-hero" data-parallax-hero data-parallax-travel="56">
  <div class="wix-parallax-frame">
    {banner && (
      <img
        src={banner}
        alt={bannerAlt}
        width="1512"
        height="156"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="wix-project-hero-image wix-parallax-image"
        data-parallax-image
      />
    )}
    <div class="wix-project-hero-overlay">
      <div class="wix-project-hero-copy">
        <h1 class="wix-project-title">{title}</h1>
        <p class="wix-project-description">{description}</p>
      </div>
    </div>
  </div>
</section>
