---
import '../styles/global.css';
import WixPromoBar from '../components/WixPromoBar.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = 'Daniyar Kurmanbayev | Portfolio',
  description = 'Daniyar Kurmanbayev portfolio.',
  canonicalPath,
  ogImage = '/assets/seo/seo-image.png',
  ogImageAlt = title,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  noindex = false,
} = Astro.props as Props;

const canonicalHref =
  canonicalPath && Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;
const ogImageHref = ogImage && Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=980, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Daniyar Kurmanbayev" />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    {ogImageHref && <meta property="og:image" content={ogImageHref} />}
    {ogImageHref && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:card" content={ogImageHref ? 'summary_large_image' : 'summary'} />
    {ogImageHref && <meta name="twitter:image" content={ogImageHref} />}
    {ogImageHref && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="theme-color" content="#1E2A38" />
  </head>
  <body>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:border focus:border-[var(--color-border-strong)] focus:bg-[var(--color-elevated)] focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <WixPromoBar />
    <SiteHeader />
    <slot />
    <script src="../scripts/parallax-hero.ts"></script>
  </body>
</html>
