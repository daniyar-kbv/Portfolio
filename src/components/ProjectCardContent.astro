---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  techLine: string;
  status?: string;
}

const { title, subtitle, description, techLine, status } = Astro.props as Props;
---

<div class="project-card-copy">
  <h3 class="project-card-title">{title}</h3>
  <p class="project-card-kicker">{subtitle}</p>
  {status && <p class="project-card-status" title={status}>{status}</p>}
  <p class="project-card-description">{description}</p>
  {techLine && <p class="project-card-tech">{techLine}</p>}
  <span class="project-card-button">View project <span aria-hidden="true">›</span></span>
</div>
