---
interface Props {
  email: string;
  linkedinUrl: string;
}

const { email, linkedinUrl } = Astro.props as Props;
const links = [
  {
    title: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: '/assets/icons/contact-icon.png',
    hoverIcon: '/assets/icons/contact-icon-hover.png',
  },
  {
    title: 'LinkedIn',
    value: 'daniyar-kbv',
    href: linkedinUrl,
    icon: '/assets/icons/linkedin-icon.png',
    hoverIcon: '/assets/icons/linkedin-icon-hover.png',
  },
];
---

<section id="contact" class="wix-strip">
  <div class="wix-divider-accent"></div>
  <div class="wix-divider-thin"></div>
  <div class="wix-footer-inner py-8 sm:py-10">
    <div class="mx-auto max-w-[650px] text-center">
      <p class="wix-section-kicker">Get in touch</p>
      <h2 class="mt-3 wix-project-title">Daniyar Kurmanbayev</h2>
      <p class="mt-2 wix-project-subtitle">Kazakhstan</p>
      <div class="mt-6 wix-project-links-grid wix-project-links-grid--compact">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer noopener' : undefined}
            aria-label={`${link.title}: ${link.value}`}
            class="wix-project-link-tile group"
          >
            <span class="relative h-12 w-12 shrink-0">
              <img
                src={link.icon}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-12 w-12 object-contain transition-opacity group-hover:opacity-0"
                loading="lazy"
                decoding="async"
              />
              <img
                src={link.hoverIcon}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-12 w-12 object-contain opacity-0 transition-opacity group-hover:opacity-100"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="wix-project-link-tile-label">{link.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
