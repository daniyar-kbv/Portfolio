---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  count?: string;
  icon?: string;
  iconAlt?: string;
  class?: string;
}

const { id, eyebrow, title, description, count, icon, iconAlt = '', class: className = '' } =
  Astro.props as Props;
---

<section id={id} class:list={['wix-section-shell', className]}>
  <div class="wix-section-divider"></div>
  <div class="wix-section-inner wix-section-inner--homepage">
    <div class="wix-section-heading wix-section-heading--homepage">
      {icon && <img src={icon} alt={iconAlt} class="wix-section-icon" loading="lazy" decoding="async" />}
      <div>
        {eyebrow && <p class="wix-section-kicker">{eyebrow}</p>}
        <h2 class="mt-3 wix-section-title">{title}</h2>
        {description && <p class="mt-3 wix-section-description">{description}</p>}
      </div>
    </div>
    <div class="wix-section-body">
      <slot />
    </div>
  </div>
</section>
