---
import { AppWindow, CreditCard, Hammer, Server, ShieldCheck, Sparkles } from '@lucide/astro';
import SectionShell from './SectionShell.astro';

type ServiceIcon = 'app' | 'sparkles' | 'payments' | 'launch' | 'rescue' | 'backend';

interface ServiceArea {
  title: string;
  description: string;
  icon: ServiceIcon;
  featured?: boolean;
}

interface Props {
  services: ServiceArea[];
}

const { services } = Astro.props as Props;

const serviceIcons = {
  app: AppWindow,
  sparkles: Sparkles,
  payments: CreditCard,
  launch: ShieldCheck,
  rescue: Hammer,
  backend: Server,
};
---

<SectionShell
  id="services"
  title="How I can help"
  description="Focused support for founders and teams who need senior iOS execution without losing product judgment."
  class="wix-home-services-section"
>
  <div class="wix-home-service-grid">
    {services.map((service) => {
      const Icon = serviceIcons[service.icon];

      return (
        <article class:list={['wix-home-service-card', service.featured && 'wix-home-service-card--featured']}>
          <span class="wix-home-service-glyph" aria-hidden="true">
            <Icon class="wix-home-service-glyph-svg" stroke-width={2.1} />
          </span>
          <div class="wix-home-service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </article>
      );
    })}
  </div>
</SectionShell>
