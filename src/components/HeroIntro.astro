---
import ButtonLink from './ButtonLink.astro';

interface Props {
  roleLabel: string;
  primaryName: string;
  headline: string;
  supporting: string;
  secondaryIdentity: string;
  ctas: Array<{
    label: string;
    href: string;
    variant: 'primary' | 'secondary' | 'ghost';
  }>;
  bannerImage: string;
  bannerAlt?: string;
}

const {
  roleLabel,
  primaryName,
  headline,
  supporting,
  secondaryIdentity,
  ctas,
  bannerImage,
  bannerAlt = 'Portfolio banner',
} = Astro.props as Props;
---

<section class="home-hero" data-parallax-hero data-parallax-travel="72">
  <div class="parallax-frame">
    <img
      src={bannerImage}
      alt={bannerAlt}
      width="1512"
      height="222"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="home-banner parallax-image"
      data-parallax-image
    />
    <div class="home-banner-overlay">
      <div class="home-banner-copy">
        <p class="home-banner-label">{roleLabel}</p>
        <p class="home-banner-primary-name">{primaryName}</p>
        <h1 class="home-banner-name">{headline}</h1>
        <p class="home-banner-secondary-name">{secondaryIdentity}</p>
        <p class="home-banner-role">{supporting}</p>
        <div class="home-hero-actions" aria-label="Primary actions">
          {ctas.map((cta) => (
            <ButtonLink href={cta.href} variant={cta.variant} class={`home-hero-action home-hero-action--${cta.variant}`}>
              {cta.label}
            </ButtonLink>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
