---
interface LinkItem {
  type: string;
  label: string;
  url: string;
}

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props as Props;

const iconByType: Record<string, { icon: string; hoverIcon: string }> = {
  github: {
    icon: '/assets/icons/github-icon.png',
    hoverIcon: '/assets/icons/github-icon-hover.png',
  },
  'app store': {
    icon: '/assets/icons/app-store-icon.png',
    hoverIcon: '/assets/icons/app-store-icon-hover.png',
  },
  website: {
    icon: '/assets/icons/website-icon.png',
    hoverIcon: '/assets/icons/website-icon-hover.png',
  },
  instagram: {
    icon: '/assets/icons/instagram-icon.png',
    hoverIcon: '/assets/icons/instagram-icon-hover.png',
  },
  demo: {
    icon: '/assets/icons/demo-icon.png',
    hoverIcon: '/assets/icons/demo-icon-hover.png',
  },
  linkedin: {
    icon: '/assets/icons/linkedin-icon.png',
    hoverIcon: '/assets/icons/linkedin-icon-hover.png',
  },
  email: {
    icon: '/assets/icons/contact-icon.png',
    hoverIcon: '/assets/icons/contact-icon-hover.png',
  },
};

function resolveIcon(type: string) {
  return iconByType[type.trim().toLowerCase()] || iconByType.website;
}

function getLabel(type: string, label: string) {
  return label?.trim() || type;
}
---

{links.length > 0 && (
  <div class="mx-auto flex w-full max-w-[650px] flex-wrap justify-center gap-3">
    {links.map((link) => {
      const icon = resolveIcon(link.type);
      const label = getLabel(link.type, link.label);
      const isExternal = link.url.startsWith('http');
      return (
        <a
          href={link.url}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noreferrer noopener' : undefined}
          aria-label={`Open ${label}`}
          title={label}
          class="wix-project-link-chip group"
        >
          <span class="relative h-4 w-4 shrink-0">
            <img
              src={icon.icon}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 h-4 w-4 object-contain transition-opacity group-hover:opacity-0"
              loading="lazy"
              decoding="async"
            />
            <img
              src={icon.hoverIcon}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 h-4 w-4 object-contain opacity-0 transition-opacity group-hover:opacity-100"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="wix-project-link-text">{label}</span>
        </a>
      );
    })}
  </div>
)}
