---
import { Maximize2, RotateCcw, X, ZoomIn, ZoomOut } from '@lucide/astro';

interface Props {
  title: string;
  banner?: string | null;
}

const { title, banner = null } = Astro.props as Props;
---

{banner && (
  <section class="wix-section-shell wix-project-media-section">
    <div class="wix-section-inner" data-project-lightbox>
      <button
        type="button"
        class="wix-project-banner-button"
        aria-label={`Open ${title} banner fullscreen`}
        data-lightbox-open
      >
        <img
          src={banner}
          alt={`${title} banner`}
          loading="lazy"
          decoding="async"
          class="wix-project-gallery-image"
        />
        <span class="wix-project-banner-expand-icon" aria-hidden="true">
          <Maximize2 class="h-5 w-5" />
        </span>
      </button>

      <dialog class="wix-project-lightbox" aria-label={`${title} banner fullscreen`} data-lightbox-dialog>
        <div class="wix-project-lightbox-toolbar" aria-label="Banner viewer controls">
          <button type="button" class="wix-project-lightbox-control" aria-label="Zoom out" data-lightbox-zoom-out>
            <ZoomOut class="h-5 w-5" aria-hidden="true" />
          </button>
          <button type="button" class="wix-project-lightbox-control" aria-label="Zoom in" data-lightbox-zoom-in>
            <ZoomIn class="h-5 w-5" aria-hidden="true" />
          </button>
          <button type="button" class="wix-project-lightbox-control" aria-label="Reset zoom" data-lightbox-reset>
            <RotateCcw class="h-5 w-5" aria-hidden="true" />
          </button>
          <button type="button" class="wix-project-lightbox-control" aria-label="Close fullscreen banner" data-lightbox-close>
            <X class="h-5 w-5" aria-hidden="true" />
          </button>
        </div>
        <div class="wix-project-lightbox-stage" data-lightbox-stage>
          <img
            src={banner}
            alt={`${title} banner`}
            decoding="async"
            class="wix-project-lightbox-image"
            draggable="false"
            data-lightbox-image
          />
        </div>
      </dialog>
    </div>
  </section>
)}

<script src="../scripts/project-lightbox.ts"></script>
