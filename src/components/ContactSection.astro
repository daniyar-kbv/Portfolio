---
interface Props {
  email: string;
  linkedinUrl: string;
}

const { email, linkedinUrl } = Astro.props as Props;
const links = [
  {
    title: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: '/assets/icons/contact-icon.png',
  },
  {
    title: 'LinkedIn',
    value: 'daniyar-kbv',
    href: linkedinUrl,
    icon: '/assets/icons/linkedin-icon.png',
  },
];
---

<section id="contact" class="wix-strip">
  <div class="wix-section-divider"></div>
  <div class="wix-footer-inner wix-contact-home-inner">
    <div class="mx-auto max-w-[650px] text-center">
      <p class="wix-section-kicker">Get in touch</p>
      <h2 class="mt-3 wix-project-title">Daniyar Kurmanbayev</h2>
      <p class="mt-2 wix-project-subtitle">Toronto, Canada</p>
      <div class="mt-8 wix-contact-hero-links">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer noopener' : undefined}
            aria-label={`${link.title}: ${link.value}`}
            class="wix-contact-hero-link group"
          >
            <span class="relative h-20 w-20 shrink-0">
              <img
                src={link.icon}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-20 w-20 object-contain transition-transform group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
            </span>
            <span class="wix-contact-hero-label">{link.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
