---
import { siteAssets, siteContact, siteOwner } from '../data/site';

interface Props {
  email?: string;
  linkedinUrl?: string;
  compact?: boolean;
}

const {
  email = siteContact.email,
  linkedinUrl = siteContact.linkedin.url,
  compact = false,
} = Astro.props as Props;
const links = [
  {
    title: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: siteAssets.icons.contact,
  },
  {
    title: 'LinkedIn',
    value: siteContact.linkedin.label,
    href: linkedinUrl,
    icon: siteAssets.icons.linkedin,
  },
];
---

<section id="contact" class:list={['wix-strip wix-contact-section', compact && 'wix-contact-section--compact']}>
  <div class="wix-section-divider"></div>
  <div class="wix-footer-inner wix-contact-home-inner">
    <div class="wix-contact-main">
      <p class="wix-contact-heading">Get in touch</p>
      <h2 class="wix-contact-name">{siteOwner.displayName}</h2>
      <p class="wix-contact-location">{siteOwner.location}</p>
      <div class="wix-contact-hero-links">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer noopener' : undefined}
            aria-label={`${link.title}: ${link.value}`}
            class="wix-contact-hero-link group"
          >
            <span class="relative h-24 w-24 shrink-0">
              <img
                src={link.icon}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-24 w-24 object-contain transition-transform group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
            </span>
            <span class="wix-contact-hero-label">{link.value}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
