---
import ButtonLink from './ButtonLink.astro';

interface Props {
  label: string;
  headline: string;
  supporting: string;
  secondaryIdentity: string;
  ctas: Array<{
    label: string;
    href: string;
    variant: 'primary' | 'secondary' | 'ghost';
  }>;
  bannerImage: string;
  bannerAlt?: string;
}

const {
  label,
  headline,
  supporting,
  secondaryIdentity,
  ctas,
  bannerImage,
  bannerAlt = 'Portfolio banner',
} = Astro.props as Props;
---

<section class="wix-home-hero" data-parallax-hero data-parallax-travel="72">
  <div class="wix-parallax-frame">
    <img
      src={bannerImage}
      alt={bannerAlt}
      width="1512"
      height="222"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="wix-home-banner wix-parallax-image"
      data-parallax-image
    />
    <div class="wix-home-banner-overlay">
      <div class="wix-home-banner-copy">
        <p class="wix-home-banner-label">{label}</p>
        <h1 class="wix-home-banner-name">{headline}</h1>
        <p class="wix-home-banner-secondary-name">{secondaryIdentity}</p>
        <p class="wix-home-banner-role">{supporting}</p>
        <div class="wix-home-hero-actions" aria-label="Primary actions">
          {ctas.map((cta) => (
            <ButtonLink href={cta.href} variant={cta.variant} class="wix-home-hero-action">
              {cta.label}
            </ButtonLink>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
