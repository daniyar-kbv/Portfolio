---
interface Props {
  title: string;
  alt?: string;
  image?: string | null;
  media?: string[] | null;
  screenshots?: string[] | null;
}

function isRenderableMediaRef(value: string | null | undefined) {
  const trimmed = String(value ?? '').trim();
  if (!trimmed || trimmed.startsWith('wix:')) return false;
  if (trimmed.startsWith('/assets/')) return true;
  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return true;
  if (trimmed.startsWith('./') || trimmed.startsWith('../')) return true;
  return /^[^:/?#][^?#]*$/.test(trimmed);
}

function isVideoRef(value: string | null | undefined) {
  return /\.(mp4|mov|webm|m4v)$/i.test(String(value ?? '').trim());
}

const { title, alt = title, image, media = [], screenshots = [] } = Astro.props as Props;
const renderableMedia = media.filter(isRenderableMediaRef);
const renderableScreenshots = screenshots.filter(isRenderableMediaRef);
const heroMedia =
  renderableMedia.find((value) => !isVideoRef(value)) ||
  (isRenderableMediaRef(image) ? image : null) ||
  renderableScreenshots[0] ||
  renderableMedia[0] ||
  null;
const additionalShots = renderableScreenshots.slice(0, 3);
const poster = (isRenderableMediaRef(image) ? image : null) || renderableScreenshots[0] || undefined;
---

{heroMedia && (
  <section class="wix-section-shell py-6 sm:py-8">
    <div class="wix-section-inner">
      <div class="wix-media-stage overflow-hidden rounded-[10px] border border-[var(--color-border)] bg-[var(--color-elevated)]">
        {renderableMedia.some(isVideoRef) ? (
          <video
            class="aspect-[980/366] w-full bg-black object-cover"
            controls
            playsinline
            preload="metadata"
            aria-label={`${title} project video`}
            poster={poster}
          >
            <source src={renderableMedia.find(isVideoRef) ?? renderableMedia[0]} />
          </video>
        ) : (
          <img
            src={heroMedia}
            alt={alt}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="aspect-[980/366] w-full object-cover"
          />
        )}
      </div>

      {additionalShots.length > 0 && (
        <div class="mt-4 grid gap-3 md:grid-cols-3">
          {additionalShots.map((shot, index) => (
            <img
              src={shot}
              alt={`${title} screenshot ${index + 1}`}
              class="aspect-[4/3] w-full rounded-[10px] border border-[var(--color-border)] object-cover"
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
      )}
    </div>
  </section>
)}
