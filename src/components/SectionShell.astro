---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  icon?: string;
  iconAlt?: string;
  class?: string;
}

const { id, eyebrow, title, description, icon, iconAlt = '', class: className = '' } = Astro.props as Props;
---

<section id={id} class:list={['section-shell', className]}>
  <div class="section-divider"></div>
  <div class="section-inner section-inner--homepage">
    <div class="section-heading section-heading--homepage">
      {icon && <img src={icon} alt={iconAlt} class="section-icon" loading="lazy" decoding="async" />}
      <div>
        {eyebrow && <p class="section-kicker">{eyebrow}</p>}
        <h2 class="mt-3 section-title">{title}</h2>
        {description && <p class="mt-3 section-description">{description}</p>}
      </div>
    </div>
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>
