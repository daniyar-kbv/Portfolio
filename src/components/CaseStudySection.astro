---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<section class:list={['section-shell case-study-section', className]}>
  <div class="section-inner">
    <div class="case-study">
      <h2 class="case-study-heading">Case study</h2>
      <p class="case-study-description">
        A closer look at the problem, implementation choices, and outcome.
      </p>
      <div class="case-study-content">
        <slot />
      </div>
    </div>
  </div>
</section>

<script>
  function getCaseStudyBlockClass(headingText) {
    const normalizedHeading = headingText.trim().toLowerCase();
    const baseClass = 'case-study-block';

    if (normalizedHeading === 'quick facts') {
      return `${baseClass} case-study-card case-study-card--facts`;
    }

    if (normalizedHeading === 'hard problems solved') {
      return `${baseClass} case-study-card case-study-card--highlight`;
    }

    return `${baseClass} case-study-block--editorial`;
  }

  function splitCaseStudyCards() {
    document.querySelectorAll('.case-study-content').forEach((content) => {
      if (content.querySelector('.case-study-block')) return;

      const nodes = Array.from(content.childNodes);
      const fragment = document.createDocumentFragment();
      let currentBlock = null;

      nodes.forEach((node) => {
        if (node.nodeType === Node.ELEMENT_NODE && node instanceof HTMLElement && node.tagName === 'H2') {
          currentBlock = document.createElement('article');
          currentBlock.className = getCaseStudyBlockClass(node.textContent ?? '');
          fragment.appendChild(currentBlock);
        }

        if (!currentBlock) {
          if (node.textContent?.trim()) {
            currentBlock = document.createElement('article');
            currentBlock.className = 'case-study-block case-study-block--editorial';
            fragment.appendChild(currentBlock);
          } else {
            return;
          }
        }

        currentBlock.appendChild(node);
      });

      content.appendChild(fragment);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', splitCaseStudyCards, { once: true });
  } else {
    splitCaseStudyCards();
  }
</script>
