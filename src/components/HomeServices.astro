---
import SectionShell from './SectionShell.astro';

type ServiceIcon =
  | 'iphone.gen3'
  | 'wand.and.sparkles'
  | 'creditcard'
  | 'checkmark.seal'
  | 'wrench.and.screwdriver'
  | 'server.rack';

interface ServiceArea {
  title: string;
  description: string;
  icon: ServiceIcon;
  featured?: boolean;
}

interface Props {
  services: ServiceArea[];
}

const { services } = Astro.props as Props;

const serviceSymbols: Record<ServiceIcon, string> = {
  'iphone.gen3': `
    <rect x="10" y="3" width="12" height="26" rx="3.8"></rect>
    <path d="M14 6.2h4"></path>
    <path d="M15.2 25.8h1.6"></path>
  `,
  'wand.and.sparkles': `
    <path d="m9.8 22.2 12.4-12.4"></path>
    <path d="m18.6 8.6 4.8 4.8"></path>
    <path d="M8.4 6.8 9.2 5l.8 1.8 1.8.8-1.8.8-.8 1.8-.8-1.8-1.8-.8 1.8-.8Z"></path>
    <path d="M23.4 20.4 24 19l.6 1.4 1.4.6-1.4.6L24 23l-.6-1.4-1.4-.6 1.4-.6Z"></path>
  `,
  creditcard: `
    <rect x="4" y="8" width="24" height="16" rx="3"></rect>
    <path d="M4 13h24"></path>
    <path d="M8 20h5"></path>
    <path d="M16 20h3"></path>
  `,
  'checkmark.seal': `
    <path d="M16 3.8 19 5l3.2-.4 1.8 2.7 2.8 1.6.2 3.2 1.5 2.9-1.5 2.9-.2 3.2-2.8 1.6-1.8 2.7-3.2-.4-3 1.2-3-1.2-3.2.4L8 22.7l-2.8-1.6-.2-3.2L3.5 15 5 12.1l.2-3.2L8 7.3l1.8-2.7L13 5l3-1.2Z"></path>
    <path d="m10.8 15.4 3.2 3.2 7.2-7.2"></path>
  `,
  'wrench.and.screwdriver': `
    <path d="m10.7 21.3-3.3 3.3a2.1 2.1 0 0 0 3 3l3.3-3.3"></path>
    <path d="M19.4 5.2a5.4 5.4 0 0 0 6.4 6.4l-5.2 5.2-6.4-6.4 5.2-5.2Z"></path>
    <path d="m7 7 18 18"></path>
    <path d="m5.2 4.4 3 3"></path>
    <path d="m23.8 25.6 3 3"></path>
  `,
  'server.rack': `
    <rect x="6" y="5" width="20" height="7" rx="2"></rect>
    <rect x="6" y="12.5" width="20" height="7" rx="2"></rect>
    <rect x="6" y="20" width="20" height="7" rx="2"></rect>
    <path d="M10 8.5h.1"></path>
    <path d="M10 16h.1"></path>
    <path d="M10 23.5h.1"></path>
    <path d="M14 8.5h8"></path>
    <path d="M14 16h8"></path>
    <path d="M14 23.5h8"></path>
  `,
};
---

<SectionShell
  id="services"
  title="How I can help"
  description="Focused support for founders and teams who need senior iOS execution without losing product judgment."
  class="wix-home-services-section"
>
  <div class="wix-home-service-grid">
    {services.map((service) => {
      const symbol = serviceSymbols[service.icon];

      return (
        <article class:list={['wix-home-service-card', service.featured && 'wix-home-service-card--featured']}>
          <span class="wix-home-service-glyph" aria-hidden="true">
            <svg
              class="wix-home-service-glyph-svg"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              set:html={symbol}
            />
          </span>
          <div class="wix-home-service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </article>
      );
    })}
  </div>
</SectionShell>
