---
import { getRenderableMediaType } from '../lib/media';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  category?: string;
  typeTags?: string[];
  techTags?: string[];
  banner?: string | null;
  bannerAlt?: string;
}

const {
  title,
  subtitle,
  description,
  category = 'Project',
  typeTags = [],
  techTags = [],
  banner,
  bannerAlt = `${title} banner`,
} = Astro.props as Props;

const heroTags = [...typeTags, ...techTags].slice(0, 5);
const bannerType = getRenderableMediaType(banner);
---

<section class="project-hero" data-parallax-hero data-parallax-travel="56">
  <div class="parallax-frame">
    {banner && bannerType === 'video' && (
      <video
        src={banner}
        aria-label={bannerAlt}
        muted
        loop
        autoplay
        playsinline
        preload="metadata"
        class="project-hero-image parallax-image"
        data-parallax-image
      />
    )}
    {banner && bannerType === 'image' && (
      <img
        src={banner}
        alt={bannerAlt}
        width="1512"
        height="156"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="project-hero-image parallax-image"
        data-parallax-image
      />
    )}
    <div class="project-hero-overlay">
      <div class="project-hero-copy">
        <p class="project-hero-label">{category} case study</p>
        <h1 class="project-title">{title}</h1>
        {subtitle && <p class="project-subtitle">{subtitle}</p>}
        <p class="project-description">{description}</p>
        {heroTags.length > 0 && (
          <ul class="project-hero-tags" aria-label={`${title} tags`}>
            {heroTags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>
