---
import ProjectCard from './ProjectCard.astro';
import SectionShell from './SectionShell.astro';

interface ProjectEntry {
  slug: string;
  data: {
    title: string;
    subtitle: string;
    description: string;
    typeTags: string[];
    techTags: string[];
    links: Array<{ type: string; label: string; url: string }>;
    status?: string;
    category: string;
    featured: boolean;
    priority: number;
    coverAlt?: string;
    thumbnail?: string;
    image?: string;
    screenshots?: string[];
    media?: string[];
  };
}

interface Props {
  id: string;
  category: string;
  title: string;
  description?: string;
  projects: ProjectEntry[];
}

const { id, category, title, description, projects } = Astro.props as Props;

const sectionIcons: Record<string, string> = {
  Flagship: '/assets/icons/flagship-icon.png',
  Production: '/assets/icons/production-icon.png',
  Backend: '/assets/icons/backend-icon.png',
  AI: '/assets/icons/ai-icon.png',
  Legacy: '/assets/icons/legacy-icon.png',
};
---

<SectionShell
  id={id}
  title={title}
  description={description}
  icon={sectionIcons[category]}
  iconAlt={`${category} icon`}
>
  <div class="wix-repeater-grid wix-repeater-grid--two">
    {projects.map((project) => {
      const image =
        project.data.thumbnail ||
        project.data.image ||
        project.data.screenshots?.[0] ||
        null;

      return (
        <ProjectCard
          slug={project.slug}
          title={project.data.title}
          subtitle={project.data.subtitle}
          description={project.data.description}
          techTags={project.data.techTags}
          image={image}
          alt={project.data.coverAlt || `${project.data.title} preview`}
          status={project.data.status}
          showVisual={category !== 'AI'}
        />
      );
    })}
  </div>
</SectionShell>
