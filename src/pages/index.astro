---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIntro from '../components/HeroIntro.astro';
import HomeProofStrip from '../components/HomeProofStrip.astro';
import HomeServices from '../components/HomeServices.astro';
import SelectedProofSection from '../components/SelectedProofSection.astro';
import ProjectArchiveSection from '../components/ProjectArchiveSection.astro';
import ContactSection from '../components/ContactSection.astro';
import {
  archiveSections,
  compactProofSlugs,
  featuredProofSlugs,
  homepageHero,
  homepageMeta,
  homepageProofPoints,
  projectOutcomeCopy,
  serviceAreas,
  siteAssets,
} from '../data/site';
import {
  groupProjectsByArchiveSection,
  indexProjectsBySlug,
  selectProjectsBySlug,
  sortProjectsByPriority,
} from '../lib/projects';

const projects = sortProjectsByPriority(await getCollection('projects'));
const projectsBySlug = indexProjectsBySlug(projects);
const featuredProofProjects = selectProjectsBySlug(projectsBySlug, featuredProofSlugs);
const compactProofProjects = selectProjectsBySlug(projectsBySlug, compactProofSlugs);
const selectedProofSlugs = new Set([...featuredProofSlugs, ...compactProofSlugs]);
const archiveProjectsByCategory = groupProjectsByArchiveSection(projects, archiveSections, selectedProofSlugs);
---

<BaseLayout
  title={homepageMeta.title}
  description={homepageMeta.description}
  canonicalPath="/"
  ogImage={siteAssets.seoImage}
  ogImageAlt={homepageMeta.ogImageAlt}
  ogTitle={homepageMeta.title}
  ogDescription={homepageMeta.description}
>
  <main id="content">
    <HeroIntro
      label={homepageHero.label}
      headline={homepageHero.headline}
      supporting={homepageHero.supporting}
      secondaryIdentity={homepageHero.secondaryIdentity}
      ctas={homepageHero.ctas}
      bannerImage={siteAssets.heroImage}
      bannerAlt={homepageHero.bannerAlt}
    />

    <HomeProofStrip proofPoints={homepageProofPoints} />
    <HomeServices services={serviceAreas} />
    <SelectedProofSection
      featuredProjects={featuredProofProjects}
      compactProjects={compactProofProjects}
      outcomes={projectOutcomeCopy}
    />
    <ProjectArchiveSection sections={archiveSections} projectsByCategory={archiveProjectsByCategory} />

    <ContactSection />
  </main>
</BaseLayout>
